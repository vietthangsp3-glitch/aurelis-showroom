# Neon pooled connection, dùng cho Next.js runtime trên Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@ep-project-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon direct connection, chỉ dùng cho Prisma Migrate, Studio và tác vụ quản trị.
DIRECT_URL="postgresql://USER:PASSWORD@ep-project.region.aws.neon.tech/neondb?sslmode=require"
SESSION_SECRET="replace-with-at-least-32-random-characters"
IP_HASH_SECRET="replace-with-an-independent-32-character-secret"
ADMIN_SEED_PASSWORD_HASH="$2b$12$replace-with-a-bcrypt-hash"
REQUIRE_ADMIN_MFA="false"
ADMIN_TOTP_SECRET=""
ALLOWED_MEDIA_HOSTS=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_CLARITY_ID=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
