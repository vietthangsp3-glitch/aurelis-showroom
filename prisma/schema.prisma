generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EDITOR
  SALES
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  APPOINTMENT
  WON
  LOST
}

enum InterestType {
  QUOTE
  TEST_DRIVE
  FINANCE
  CAR_SELECTION
  PROMOTION
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role        @default(SALES)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditLogs    AuditLog[]
  articles     Article[]
  assignedLeads Lead[]     @relation("AssignedLeads")
}

model Brand {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  logoUrl     String?
  description String?
  seoTitle    String?
  seoDescription String?
  models      VehicleModel[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model VehicleModel {
  id        String    @id @default(cuid())
  brandId   String
  name      String
  slug      String    @unique
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([brandId, name])
  @@index([brandId])
}

model Vehicle {
  id          String          @id @default(cuid())
  modelId     String
  slug        String          @unique
  year        Int
  bodyType    String
  segment     String
  fuelType    String
  seats       Int
  description String
  exterior    String
  interior    String
  technology  String
  safety      String
  seoTitle    String?
  seoDescription String?
  status      PublishStatus   @default(DRAFT)
  publishedAt DateTime?
  model       VehicleModel    @relation(fields: [modelId], references: [id], onDelete: Restrict)
  variants    VehicleVariant[]
  images      VehicleImage[]
  categories  VehicleCategory[]
  promotions  PromotionVehicle[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([modelId, status, publishedAt])
  @@index([bodyType, fuelType, seats])
}

model VehicleVariant {
  id           String             @id @default(cuid())
  vehicleId    String
  name         String
  sku          String             @unique
  price        Decimal            @db.Decimal(15, 0)
  salePrice    Decimal?           @db.Decimal(15, 0)
  engine       String
  horsepower   Int
  torque       Int
  acceleration Decimal            @db.Decimal(4, 1)
  transmission String
  drivetrain   String
  dimensions   String
  vehicle      Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  inventory    VehicleInventory[]
  leads        Lead[]
  testDrives   TestDriveBooking[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([vehicleId, price])
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  mediaId   String?
  url       String
  alt       String
  kind      String   @default("GALLERY")
  position  Int      @default(0)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  media     Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([vehicleId, position])
}

model Category {
  id       String            @id @default(cuid())
  name     String            @unique
  slug     String            @unique
  vehicles VehicleCategory[]
}

model VehicleCategory {
  vehicleId  String
  categoryId String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([vehicleId, categoryId])
  @@index([categoryId])
}

model Showroom {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  address     String
  city        String
  phone       String
  openingHours String
  latitude    Decimal?           @db.Decimal(10, 7)
  longitude   Decimal?           @db.Decimal(10, 7)
  inventory   VehicleInventory[]
  testDrives  TestDriveBooking[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model VehicleInventory {
  id         String         @id @default(cuid())
  variantId  String
  showroomId String
  color      String
  quantity   Int            @default(0)
  status     String         @default("AVAILABLE")
  variant    VehicleVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  showroom   Showroom       @relation(fields: [showroomId], references: [id], onDelete: Cascade)
  updatedAt  DateTime       @updatedAt

  @@unique([variantId, showroomId, color])
  @@index([showroomId, status])
}

model Lead {
  id                   String         @id @default(cuid())
  name                 String
  phone                String
  email                String?
  variantId            String?
  brand                String?
  interestType         InterestType
  preferredContactTime String
  note                 String?
  source               String
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  landingPage          String?
  referrer             String?
  status               LeadStatus     @default(NEW)
  fingerprint          String
  submissionKey        String          @unique
  assignedToId         String?
  variant              VehicleVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  assignedTo           User?           @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities           LeadActivity[]
  testDrive            TestDriveBooking?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([phone, createdAt])
  @@index([fingerprint, createdAt])
  @@index([status, assignedToId])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  userId    String?
  type      String
  note      String?
  metadata  Json?
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model TestDriveBooking {
  id         String         @id @default(cuid())
  leadId     String         @unique
  variantId  String
  showroomId String
  scheduledAt DateTime
  status     String         @default("PENDING")
  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  variant    VehicleVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  showroom   Showroom       @relation(fields: [showroomId], references: [id], onDelete: Restrict)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Promotion {
  id          String             @id @default(cuid())
  title       String
  slug        String             @unique
  description String
  startsAt    DateTime
  endsAt      DateTime
  status      PublishStatus      @default(DRAFT)
  vehicles    PromotionVehicle[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model PromotionVehicle {
  promotionId String
  vehicleId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([promotionId, vehicleId])
}

model Article {
  id             String        @id @default(cuid())
  authorId       String
  title          String
  slug           String        @unique
  excerpt        String
  content        String
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  author         User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Media {
  id         String         @id @default(cuid())
  publicId   String         @unique
  url        String
  mimeType   String
  width      Int?
  height     Int?
  bytes      Int
  alt        String?
  uploadedBy String?
  images     VehicleImage[]
  createdAt  DateTime       @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}
